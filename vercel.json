{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/oauth/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|oauth/).*)",
      "destination": "/index.html"
    }
  ]
}
